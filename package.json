{
  "name": "cryptopup",
  "version": "1.0.0",
  "description": "CrypTopUp - Data Top-Up Platform",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npm run clean && npm run copy-assets",
    "clean": "rimraf dist",
    "copy-assets": "mkdir dist && xcopy /E /I public dist\\public && xcopy /E /I views dist\\views && copy app.js dist\\ && copy package.json dist\\ && copy .env.production dist\\.env"
  },
  "dependencies": {
    "africastalking": "^0.7.3",
    "bcrypt": "^5.1.1",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.1",
    "chart.js": "^4.4.1",
    "cookie-parser": "^1.4.6",
    "connect-mongo": "^5.0.0",
    "csurf": "^1.11.0",
    "dotenv": "^16.0.3",
    "helmet": "^7.0.0",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.0.1",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "socket.io": "^4.8.1",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5"
  }
}
