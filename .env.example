# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=CrypTopUp
APP_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/cryptopup?retryWrites=true&w=majority

# Security Configuration
SESSION_SECRET=your_session_secret
COOKIE_SECRET=your_cookie_secret
CSRF_SECRET=your_csrf_secret
JWT_SECRET=your_jwt_secret

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_EMAIL=admin@example.com

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=0

# Africa's Talking Configuration
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_ENVIRONMENT=sandbox

# Reloadly Configuration
RELOADLY_CLIENT_ID=your_client_id
RELOADLY_CLIENT_SECRET=your_client_secret
RELOADLY_API_KEY=your_api_key
RELOADLY_ENVIRONMENT=sandbox

# Blockchain Configuration
WEB3_PROVIDER=https://polygon-mumbai.infura.io/v3/your_infura_project_id
WEB3_WS_PROVIDER=wss://polygon-mumbai.infura.io/ws/v3/your_infura_project_id
PROJECT_WALLET=your_project_wallet_address
USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
CHAIN_ID=80001
BLOCK_CONFIRMATIONS=6

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=dev
