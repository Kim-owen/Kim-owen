<%- include('layout', { title: 'Settings', path: 'settings' }) %>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">System Settings</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-4">
                    <h6 class="text-muted">Blockchain Configuration</h6>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-4">Project Wallet</dt>
                        <dd class="col-sm-8">
                            <div class="d-flex align-items-center">
                                <span class="text-break"><%= config.PROJECT_WALLET %></span>
                                <button class="btn btn-sm btn-outline-secondary ms-2" 
                                        onclick="copyToClipboard('<%= config.PROJECT_WALLET %>')" 
                                        title="Copy to clipboard">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </dd>
                        
                        <dt class="col-sm-4">USDT Contract</dt>
                        <dd class="col-sm-8">
                            <div class="d-flex align-items-center">
                                <span class="text-break"><%= config.USDT_CONTRACT %></span>
                                <button class="btn btn-sm btn-outline-secondary ms-2" 
                                        onclick="copyToClipboard('<%= config.USDT_CONTRACT %>')" 
                                        title="Copy to clipboard">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </dd>
                        
                        <dt class="col-sm-4">Web3 Provider</dt>
                        <dd class="col-sm-8"><%= config.WEB3_PROVIDER %></dd>
                        
                        <dt class="col-sm-4">Network</dt>
                        <dd class="col-sm-8"><span class="badge bg-info">Mumbai Testnet (Polygon)</span></dd>
                    </dl>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="mb-4">
                    <h6 class="text-muted">External APIs</h6>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-4">Africa's Talking</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">Connected</span>
                            <small class="text-muted d-block mt-1">Username: <%= config.AFRICASTALKING_USERNAME %></small>
                        </dd>
                        
                        <dt class="col-sm-4">Reloadly</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">Connected</span>
                        </dd>
                    </dl>
                </div>
                
                <div class="mb-4">
                    <h6 class="text-muted">System Information</h6>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-4">Environment</dt>
                        <dd class="col-sm-8"><%= process.env.NODE_ENV || 'development' %></dd>
                        
                        <dt class="col-sm-4">Server Uptime</dt>
                        <dd class="col-sm-8"><%= uptime %></dd>
                        
                        <dt class="col-sm-4">Database</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-success">Connected</span>
                            <small class="text-muted d-block mt-1">MongoDB</small>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0">Supported Countries & Operators</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Country</th>
                        <th>Operators</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% operatorsByCountry.forEach(country => { %>
                    <tr>
                        <td>
                            <strong><%= country.name %></strong>
                        </td>
                        <td>
                            <% country.operators.forEach(op => { %>
                                <span class="badge bg-secondary me-1"><%= op %></span>
                            <% }) %>
                        </td>
                        <td><span class="badge bg-success">Active</span></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text)
            .then(() => {
                alert('Copied to clipboard');
            })
            .catch(err => {
                console.error('Failed to copy:', err);
            });
    }
</script>
