<%- contentFor('body') %>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-circle text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="h3 mb-3">Oops! Something went wrong</h1>
                    <p class="text-muted mb-4"><%= typeof error === 'string' ? error : (error && error.message ? error.message : 'An unexpected error occurred') %></p>
                    <div class="d-flex justify-content-center gap-3">
                        <% if (typeof isLoginPage === 'undefined' || !isLoginPage) { %>
                            <a href="/admin" class="btn btn-primary">
                                <i class="bi bi-house-door me-2"></i>Back to Dashboard
                            </a>
                        <% } else { %>
                            <a href="/admin/login" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Back to Login
                            </a>
                        <% } %>
                        <button onclick="window.history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Go Back
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
