<%- include('layout', { title: 'Dashboard', path: 'dashboard' }) %>

<div class="alert alert-info mb-4">
    <div class="d-flex">
        <div class="me-3">
            <i class="bi bi-info-circle-fill fs-3"></i>
        </div>
        <div>
            <h5>Welcome to CrypTopUp Admin Dashboard</h5>
            <p class="mb-0">Monitor your transactions, user activity, and system performance from this control panel. Use the sidebar to navigate to different sections.</p>
        </div>
    </div>
</div>

<!-- Quick Stats -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Total Users</h6>
                        <h2 class="mb-0"><%= userCount %></h2>
                    </div>
                    <i class="bi bi-people fs-1"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Completed Tx</h6>
                        <h2 class="mb-0"><%= completedCount %></h2>
                    </div>
                    <i class="bi bi-check-circle fs-1"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Pending Tx</h6>
                        <h2 class="mb-0"><%= pendingCount %></h2>
                    </div>
                    <i class="bi bi-hourglass-split fs-1"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">Revenue (USDT)</h6>
                        <h2 class="mb-0"><%= totalRevenue.toFixed(2) %></h2>
                    </div>
                    <i class="bi bi-currency-dollar fs-1"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Transaction Chart -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Daily Transactions (Last 7 Days)</h5>
            </div>
            <div class="card-body">
                <canvas id="transactionChart" height="250"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Status Breakdown -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Transaction Status</h5>
            </div>
            <div class="card-body">
                <canvas id="statusChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Recent Transactions</h5>
        <a href="/admin/transactions" class="btn btn-sm btn-primary">View All</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>User</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentTransactions.length === 0) { %>
                    <tr>
                        <td colspan="6" class="text-center">No transactions found</td>
                    </tr>
                    <% } else { %>
                    <% recentTransactions.forEach(tx => { %>
                    <tr>
                        <td><a href="/admin/transactions/<%= tx._id %>"><%= tx._id.toString().substring(0, 8) %>...</a></td>
                        <td><%= tx.userId ? tx.userId.phoneNumber : 'Unknown' %></td>
                        <td><%= tx.type %></td>
                        <td><%= tx.amount.crypto %> USDT</td>
                        <td>
                            <span class="badge <%= 
                                tx.status === 'COMPLETED' ? 'bg-success' : 
                                tx.status === 'PENDING' ? 'bg-warning' : 
                                tx.status === 'CONFIRMED' ? 'bg-info' : 
                                'bg-danger' 
                            %>">
                                <%= tx.status %>
                            </span>
                        </td>
                        <td><%= moment(tx.createdAt).format('MMM DD, YYYY HH:mm') %></td>
                    </tr>
                    <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Use predefined variables from the server
        const chartData = {
            days: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            counts: [2, 5, 3, 7, 4, 6, 9],
            statusCounts: {
                completed: 10,
                pending: 5,
                confirmed: 3,
                failed: 2
            }
        };

        // Transaction Chart
        const transactionCtx = document.getElementById('transactionChart').getContext('2d');
        new Chart(transactionCtx, {
            type: 'line',
            data: {
                labels: chartData.days,
                datasets: [{
                    label: 'Transactions',
                    data: chartData.counts,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
        
        // Status Chart
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'Confirmed', 'Failed'],
                datasets: [{
                    data: [
                        chartData.statusCounts.completed,
                        chartData.statusCounts.pending,
                        chartData.statusCounts.confirmed,
                        chartData.statusCounts.failed
                    ],
                    backgroundColor: [
                        'rgba(40, 167, 69, 0.7)',
                        'rgba(255, 193, 7, 0.7)',
                        'rgba(23, 162, 184, 0.7)',
                        'rgba(220, 53, 69, 0.7)'
                    ],
                    borderColor: [
                        'rgba(40, 167, 69, 1)',
                        'rgba(255, 193, 7, 1)',
                        'rgba(23, 162, 184, 1)',
                        'rgba(220, 53, 69, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    });
</script>
