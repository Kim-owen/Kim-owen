<%- contentFor('body') %>
<%- contentFor('extraStyles') %>
<style>
.icon-shape {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.icon-shape i {
    font-size: 1.25rem;
}
</style>

<%- contentFor('extraScripts') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

<div class="container-fluid py-4">
    <!-- Statistics Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-normal text-muted mb-1">Total Users</h6>
                            <h4 class="mb-0"><%= totalUsers %></h4>
                        </div>
                        <div class="icon-shape bg-primary text-white rounded-3">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-normal text-muted mb-1">Total Transactions</h6>
                            <h4 class="mb-0"><%= totalTransactions %></h4>
                        </div>
                        <div class="icon-shape bg-success text-white rounded-3">
                            <i class="fas fa-exchange-alt"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-normal text-muted mb-1">Total Revenue</h6>
                            <h4 class="mb-0">$<%= totalRevenue %></h4>
                        </div>
                        <div class="icon-shape bg-info text-white rounded-3">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-normal text-muted mb-1">Pending Orders</h6>
                            <h4 class="mb-0"><%= pendingOrders %></h4>
                        </div>
                        <div class="icon-shape bg-warning text-white rounded-3">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Recent Transactions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th scope="col">#ID</th>
                                    <th scope="col">User</th>
                                    <th scope="col">Amount</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Date</th>
                                    <th scope="col">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentTransactions.forEach(function(transaction) { %>
                                <tr>
                                    <td>#<%= transaction.id %></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="<%= transaction.userAvatar %>" class="rounded-circle" width="32" height="32">
                                            <span class="ms-2"><%= transaction.userName %></span>
                                        </div>
                                    </td>
                                    <td>$<%= transaction.amount %></td>
                                    <td><%= transaction.type %></td>
                                    <td>
                                        <span class="badge bg-<%= transaction.status === 'completed' ? 'success' : 
                                            transaction.status === 'pending' ? 'warning' : 'danger' %>">
                                            <%= transaction.status %>
                                        </span>
                                    </td>
                                    <td><%= transaction.date %></td>
                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-link" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="/admin/transaction/<%= transaction.id %>">View Details</a></li>
                                                <li><a class="dropdown-item" href="#">Update Status</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
